# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SPECTATOR_TOKEN_SECRET=optional_extra_secret_for_public_screen_links

# Optional
# NODE_ENV=production

# Optional lane-screen bridge (server-only). All fields required to enable it.
LANE_SCREEN_PLAYGROUND_URL=
LANE_SCREEN_BRIDGE_SECRET=
LANE_SCREEN_ALLOWED_USER_IDS=
LANE_SCREEN_LANES=
# Authenticates the scheduled approved-result retry endpoint.
CRON_SECRET=
